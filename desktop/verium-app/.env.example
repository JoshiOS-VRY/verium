# Optional: Verium pool Supabase anon key for in-wallet miner dashboard RPCs.
# Global pool stats work via https://pool.vericonomy.com/api/stats without this.
# Copy from verium-pool apps/web or vericonomy-web .env.local.
# Loaded by src-tauri/build.rs from .env, ../.env, or ../.env.local
POOL_SUPABASE_ANON_KEY=
POOL_SUPABASE_URL=https://pctpdmqxideezyqxvxbj.supabase.co

# Light wallet (Electrum) — alpha builds hide this unless both are set:
# VITE_LIGHT_WALLET_ENABLED=true
# VERICONOMY_LIGHT_WALLET=1
# Restart `npm run tauri:dev` after changing these (Vite does not hot-reload .env).
